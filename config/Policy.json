{
    "IdentityPolicy": {
        "AllowedAdmins": [
            "Administrator",
            "AzureAD\\DinBruker",
            "SystemAdmin"
        ],
        "MaxInactiveDays": 90
    },
    "NetworkPolicy": {
        "FirewallRequired": true,
        "BlockGuestAccess": true,
        "AutoRemediate": false
    },
    "SystemPolicy": {
        "MinFreeDiskGB": 10,
        "RequireWindowsUpdate": true,
        "MaxDaysSinceLastUpdate": 30
    }
}